{
    "name": "abra-sua-biblia",
    "private": true,
    "type": "module",
    "engines": {
        "node": "26.x"
    },
    "scripts": {
        "dev": "vite",
        "build": "npm run typecheck && vite build && node scripts/check-dist.mjs",
        "preview": "vite preview",
        "typecheck": "svelte-check --tsgo --tsconfig ./tsconfig.json --fail-on-warnings && tsc --noEmit -p src/sw",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "npm run bibles:fetch && playwright test",
        "check": "npm run typecheck && npm run lint && npm run test",
        "bibles:fetch": "node scripts/fetch-bibles.ts",
        "bibles:catalog": "node scripts/catalog.ts"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.1",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@types/html-minifier-terser": "^7.0.2",
        "@types/node": "^26.6.6",
        "@typescript/native": "npm:typescript@^7.0.2",
        "easy-bible-format": "git+https://github.com/natanael127/easy-bible-format.git#bd1623bd09abd2465c06a72ffd226d50f575bafd",
        "eslint": "^10.13.0",
        "eslint-plugin-svelte": "^3.24.0",
        "globals": "^17.13.0",
        "html-minifier-terser": "^7.2.0",
        "jsdom": "^30.1.3",
        "svelte-check": "^4.7.8",
        "svelte-eslint-parser": "^1.10.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5",
        "vite-plugin-pwa": "^2.0.0",
        "vitest": "^5.0.5",
        "workbox-build": "^7.4.1",
        "workbox-core": "^7.4.1",
        "workbox-precaching": "^7.4.1",
        "workbox-routing": "^7.4.1",
        "workbox-strategies": "^7.4.1",
        "workbox-window": "^7.4.1"
    },
    "dependencies": {
        "ajv": "^8.20.0",
        "clipboard-copy": "^4.0.1",
        "es-toolkit": "^1.53.0",
        "fast-xml-parser": "^5.11.2",
        "flag-icons": "^7.6.0",
        "i18next": "^26.7.1",
        "iso-639-3": "^3.0.1",
        "minisearch": "^7.2.0",
        "notyf": "^3.10.0",
        "svelte": "^5.57.3"
    },
    "overrides": {
        "glob": "^14.0.3",
        "minimatch": "^11.0.4"
    }
}
